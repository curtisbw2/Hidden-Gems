# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
GUILD_ID=your_guild_id_here

# Role Names (defaults, can override with IDs)
ROLE_FREE=Free Member
ROLE_PREMIUM=Premium Member
ROLE_ADMIN=Admin
ROLE_MOD=Mod

# Role IDs (optional, overrides names)
# ROLE_FREE_ID=123456789
# ROLE_PREMIUM_ID=123456790
# ROLE_ADMIN_ID=123456791
# ROLE_MOD_ID=123456792

# Channel Names (defaults, can override with IDs)
CHANNEL_VERIFY=verify
CHANNEL_VERIFY_QUEUE=verify-queue
CHANNEL_BOT_LOGS=bot-logs
CHANNEL_ALERTS=alerts

# Channel IDs (optional, overrides names)
# CHANNEL_VERIFY_ID=123456793
# CHANNEL_VERIFY_QUEUE_ID=123456794
# CHANNEL_BOT_LOGS_ID=123456795
CHANNEL_ALERTS_ID=1460785397079736420

# Optional: Fallback channel for failed DMs
# CHANNEL_FALLBACK_DM=123456797

# Onboarding
AUTO_ASSIGN_FREE_ON_JOIN=true

# Email/OTP (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=noreply@yourdomain.com
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Verification Queue
VERIFY_COOLDOWN_MINUTES=30
PROOF_TIMEOUT_MINUTES=10

# CSV Import
# If true, users who currently have Premium but whose linked email is NOT active in the latest paid subscriber import
# will have Premium revoked on the next `/import_paid_csv` or `/sync_premium`.
STRICT_REVOKE=true

# Alerts
ALERT_TIME=16:10  # Scheduled time (HH:MM) - default: 16:10 ET after market close
ALERT_TIMEZONE=America/New_York
# ALERT_CHECK_INTERVAL_MINUTES=60  # Optional: check every N minutes instead of scheduled time
ALERT_THRESHOLD_PERCENT=10.0
ALERT_TICKERS=RR,ONDS,ACHR,UMAC,AMPX,LPTH
ENABLE_DAILY_ALERTS=false

# Intraday Alerts (RTH-only)
ENABLE_INTRADAY_ALERTS=true
# INTRADAY_POLL_SECONDS=60
INTRADAY_THRESHOLDS=5,10
INTRADAY_ALERT_COOLDOWN_SECONDS=120

# Alerts Role mention (recommended: set ID so pings always work)
ALERTS_ROLE_ID=1462219058245271865
ALERTS_ROLE_NAME=Alerts
ALERTS_MENTION_ENABLED=false

# Alerts Role Panel (self-serve opt-in/out)
# Optional: you can still set a default panel channel for your own organization,
# but `/post_alerts_role_panel` can now be run in any text channel and will post there.
# ALERTS_ROLE_PANEL_CHANNEL_ID=1443372184088215664
ALERTS_ROLE_PANEL_CHANNEL_NAME=alerts-settings

# Substack RSS Monitoring
# Example: SUBSTACK_RSS_URL=https://hiddengemsresearchllc.substack.com/feed
# SUBSTACK_RSS_URL=https://hiddengemsresearchllc.substack.com/feed
# SUBSTACK_CHECK_INTERVAL_MINUTES=15  # How often to check for new posts (default: 15 minutes)
# CHANNEL_SUBSTACK=substack  # Channel name for Substack notifications (default: "substack")
# CHANNEL_SUBSTACK_ID=1443372184088215665  # Channel ID for announcements channel

# Database
# For local development (SQLite):
DB_PATH=data/bot.db

# For production (Postgres on Railway):
# DATABASE_URL will be automatically set when you add a Postgres service in Railway
# Or set manually: DATABASE_URL=postgresql://user:password@host:port/database
# DATABASE_URL=

# Logging
LOG_LEVEL=INFO

# ----------------------------
# Security (anti-impersonation / anti-bot)
# ----------------------------
# Enable join-time impersonation checks in `OnboardingCog.on_member_join`
SECURITY_IMPERSONATION_GUARD_ENABLED=true

# Recommended: set the *real* owner's Discord user ID (Developer Mode → Copy User ID)
# This prevents false positives for the real owner and enables avatar matching.
SECURITY_OWNER_USER_ID=189458608679813120

# Optional: extra name aliases to match against (comma-separated). These are used if the owner ID
# can’t be resolved (e.g., owner not in guild cache yet) or if you want additional match strings.
# SECURITY_OWNER_NAME_ALIASES=JT,JT at Hidden Gems Research,hidden_gems

# Optional: allow-list of bot IDs (comma-separated). Only used if banning untrusted bots is enabled.
# SECURITY_TRUSTED_BOT_IDS=123456789012345678,234567890123456789

# If true, any bot account that joins and is NOT in SECURITY_TRUSTED_BOT_IDS will be actioned.
SECURITY_BAN_UNTRUSTED_BOTS_ON_JOIN=false

# What to do when a match triggers: ban | kick | quarantine
SECURITY_IMPERSONATION_ACTION=ban

# If using quarantine, configure the role (ID preferred)
# SECURITY_QUARANTINE_ROLE_ID=123456789012345678
SECURITY_QUARANTINE_ROLE_NAME=Quarantine

# Supporting signal used when owner avatar can’t be compared (e.g., owner member not resolved):
# accounts newer than this may be blocked if they match owner name/aliases.
SECURITY_MIN_ACCOUNT_AGE_DAYS=3

# Fuzzy name matching threshold (0..1). Higher = stricter (fewer false positives).
# The guard triggers when: avatar matches AND account is younger than SECURITY_MIN_ACCOUNT_AGE_DAYS
# AND best name similarity >= this threshold.
SECURITY_NAME_SIMILARITY_THRESHOLD=0.84

# Optional: channel to announce when an imposter is banned
SECURITY_IMPOSTER_ANNOUNCE_CHANNEL_ID=1443372184088215668
